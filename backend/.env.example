# Application
NODE_ENV=development
PORT=5000
APP_NAME="Inventory Management System"
APP_URL=http://localhost:5000

# Database
DATABASE_URL="mysql://root:password@localhost:3306/inventory_db"

# JWT Secrets
JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Security
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MINUTES=30

# CORS
CORS_ORIGIN=http://localhost:3003
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@inventory.com

# Redis (Optional - for caching and queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=logs/

# Backup
BACKUP_PATH=backups/
AUTO_BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 0 * * *"

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
