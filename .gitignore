# Documentation files (as requested)
# Exclude all markdown files except essential ones
*.md
!README.md
!CONTRIBUTING.md
!LICENSE.md
!CHANGELOG.md
# Exclude AI assistant skill files
.agents/**/*.md
.claude/**/*.md
.windsurf/**/*.md
.cursor/**/*.md

# Keep .env.example for reference
!.env.example
!**/.env.example
